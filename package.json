{
  "name": "hancode",
  "version": "1.0.0",
  "description": "HanCode MVP coding agent built with Bun, TypeScript, and Claude tool use",
  "author": "HanCode Team",
  "type": "module",
  "main": "out/main/index.cjs",
  "bin": {
    "hancode": "src/hancode.ts",
    "hancode-once": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/hancode.ts",
    "chat": "bun run src/hancode.ts",
    "once": "bun run src/cli.ts",
    "desktop:dev": "node node_modules/electron-vite/bin/electron-vite.js dev --config apps/desktop/electron.vite.config.ts",
    "desktop:build": "electron-vite build --config apps/desktop/electron.vite.config.ts",
    "desktop:sidecar": "bun build --compile src/desktop/sidecar.ts --outfile out/sidecar/hancode-sidecar.exe",
    "desktop:dist": "bun run desktop:build && bun run desktop:sidecar && electron-builder --win",
    "desktop:dist:cn": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ bun run desktop:dist",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@vitejs/plugin-react": "latest",
    "electron-vite": "latest",
    "highlight.js": "^11.11.1",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest"
  }
}
